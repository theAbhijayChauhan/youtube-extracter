# ZenthYT Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000

# Ephemeral Temporary Working Directory (e.g., /tmp on Linux or memory ramdisk)
CUSTOM_TEMP_DIR=/tmp/zenthyt_temp

# Optional: Rotating Residential / Datacenter Proxy to prevent YouTube IP blocks
# Format: http://user:password@proxy_ip:proxy_port
# YOUTUBE_PROXY=http://user:password@proxy.example.com:8080

# Optional: Cookies File for bypassing bot verifications or accessing private/age-restricted content
# YOUTUBE_COOKIES_FILE=cookies.txt
